# Copy to .env and adjust if needed:  cp .env.example .env
POSTGRES_DB=scanner_db
POSTGRES_USER=scanner
POSTGRES_PASSWORD=scanner

# App (host) connects to the Docker Postgres via localhost
DATABASE_URL=postgresql://scanner:scanner@localhost:5432/scanner_db

# Where the capture files live (relative to project root, or absolute)
CAPTURES_DIR=captures

# --- S3 / cloud upload (Phase 2) ---
# Local testing uses MinIO (S3-compatible). For real AWS S3:
#   - leave S3_ENDPOINT_URL empty
#   - set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY to your real keys
#   - set AWS_REGION + S3_BUCKET to your bucket
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=scanner-pointclouds
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MAX_UPLOAD_RETRIES=3
